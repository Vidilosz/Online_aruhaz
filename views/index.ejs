<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        title
    </title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Products</h1>
    
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Stock</th>
            </tr>
        </thead>
        <tbody>
            <% products.forEach(product => { %>
                <tr>
                    <td><%= product.name %></td>
                    <td><%= product.category %></td>
                    <td><%= product.price %></td>
                    <td><%= product.stock %></td>
                </tr>
            <% }) %>
        </tbody>


    <a href="filter">Szűrés</a> <br>
    <a href="new">Új termék</a> <br>
    <a href="stats">Statisztikák</a> <br>
</body>
</html>